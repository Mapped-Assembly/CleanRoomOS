{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "cleanroom",
  "agent": {
    "cleanroom": {
      "description": "Coordinate the cleanroom AI-human simulation",
      "mode": "primary",
      "prompt": "{file:./prompts/coordinator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": {
          "*": "deny",
          "cleanroom-operation": "allow",
          "cleanroom-risk": "allow",
          "cleanroom-compliance": "allow"
        }
      }
    },
    "cleanroom-operation": {
      "description": "Generate cleanroom operation tasks",
      "mode": "subagent",
      "prompt": "{file:./prompts/operation.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "cleanroom-risk": {
      "description": "Assess task risk and attempt de-risking",
      "mode": "subagent",
      "prompt": "{file:./prompts/risk.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "cleanroom-compliance": {
      "description": "Produce the Tracking and trending report",
      "mode": "subagent",
      "prompt": "{file:./prompts/compliance.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
