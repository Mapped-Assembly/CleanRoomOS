{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "cleanroom",
  "permission": {
    "*": "deny"
  },
  "agent": {
    "cleanroom-help": {
      "description": "Show the Python controller entry point",
      "mode": "primary",
      "prompt": "{file:./prompts/help.md}",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    },
    "cleanroom-requirements": {
      "description": "Extract cited SOP/recipe requirements and explicit gaps",
      "mode": "subagent",
      "prompt": "{file:./prompts/requirements.md}",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    },
    "cleanroom-planning": {
      "description": "Propose a sampling schedule without changing requirements",
      "mode": "subagent",
      "prompt": "{file:./prompts/planning.md}",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    },
    "cleanroom-results-review": {
      "description": "Explain deterministic findings for human QA review",
      "mode": "subagent",
      "prompt": "{file:./prompts/results-review.md}",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    },
    "cleanroom": {
      "description": "Interactive cleanroom sampling and QA demo",
      "mode": "primary",
      "prompt": "{file:./prompts/cleanroom.md}",
      "permission": {
        "*": "deny",
        "cleanroom_workflow": "allow",
        "cleanroom_decision": "ask"
      }
    }
  },
  "instructions": [
    "docs/cleanroom-sop.md"
  ]
}
